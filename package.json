{
  "name": "supplymind-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @supplymind/web dev",
    "dev:api": "pnpm --filter @supplymind/api start:dev",
    "build:shared": "pnpm --filter @supplymind/shared build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.8.2"
  }
}
